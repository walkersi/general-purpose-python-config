{
    "data_types": [
        {
            "name": ["url", "link", "hyperlink"],
            "parent": "string",
            "valid": {
                "regex": "^(https?:\/\/)?(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)$"
            }
        },
        {
            "name": ["path", "file", "file path", "file name"],
            "parent": "string",
            "valid": {
                "regex": "^([a-zA-Z]+:\\/)?\\/?([a-zA-Z0-9\\.\\-_ \\,\\(\\)\\[\\]\\{\\}\\#\\@\\^\\$\\%\\&\\+]*\\/)*([a-zA-Z0-9\\.\\-_ \\,\\(\\)\\[\\]\\{\\}\\#\\@\\^\\$\\%\\&\\+]+)$"
            }
        },
        {
            "name": "set of paths",
            "parent": {
                "type": "set of",
                "parameters": {
                    "item_type": "path"
                }
            }
        },
        {
            "name": ["ipv4", "ipv4 address"],
            "parent": "string",
            "valid": {
                "regex": "^((([01]?\\d?\\d)|(2[0-4]\\d)|(25[0-5]))\\.){3}((([01]?\\d?\\d)|(2[0-4]\\d)|(25[0-5])))$"
            }
        },
        {
            "name": ["ipv6", "ipv6 address"],
            "parent": "string",
            "valid": {
                "regex": "^([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}$"
            }
        },
        {
            "name": ["ip", "any ip", "ip address"],
            "valid": {
                "union": {
                    "types": ["ipv4", "ipv6"],
                    "yields_like": "string"
                }
            }
        },
        {
            "name": ["mac", "mac address"],
            "parent": "string",
            "valid": {
                "regex": "^([0-9a-fA-F]{1,2}[:-]){5}[0-9a-fA-F]{1,2}$"
            }
        }
    ]
}