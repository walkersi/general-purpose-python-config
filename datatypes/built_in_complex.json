{
    "data_types": [
        {
            "name": ["alphanumeric string", "alphanumeric str", "alphanumeric"],
            "parent": "string",
            "valid": {
                "regex": "^[A-Z0-9a-z ]*$"
            }
        },
        {
            "name": ["strict alphanumeric", "strict alphanumeric string", "strict alphanumeric str"],
            "parent": "string",
            "valid": {
                "regex": "^[A-Z0-9a-z]+$"
            }
        },
        {
            "name": "duration",
            "description": "Must be a positive numerical duration with a time unit",
            "valid": {
                "units": ["s", "ms", "hr", "day", "min", "week"],
                "target_unit": "s",
                "aliases": {
                    "s": ["sec", "secs", "seconds", "second"],
                    "ms": ["msec", "msecs", "milliseconds", "millisecond"],
                    "min": ["m", "minute", "minutes", "mins"],
                    "day": ["days", "d"],
                    "hr": ["hour", "h", "hrs", "hours"],
                    "week": ["weeks", "wk", "w"]
                },
                "conversion": {
                    "s": "1000ms",
                    "min": "60s",
                    "hr": "60min",
                    "day": "24hr",
                    "week": "7day"
                },
                "range": "n >= 0"
            }
        },
        {
            "name": "per duration",
            "description": "Must be a positive numerical value per a duration time unit",
            "valid": {
                "units": ["per s", "per ms", "per hr", "per day", "per min", "per week"],
                "target_unit": "per s",
                "aliases": {
                    "per s": ["per sec", "per second", "/s", "s-1", "/sec", "/second"],
                    "per ms": ["per msec", "per millisecond", "/ms", "/msec", "/millisecond"],
                    "per min": ["per m", "per minute", "/m", "/min", "/minute"],
                    "per day": ["per d", "/day", "/d"],
                    "per hr": ["per h", "per hour", "/hr", "/h", "/hour"],
                    "per week": ["per wk", "per w", "/w", "/week", "/wk"]
                },
                "conversion": {
                    "per ms": "1000per s",
                    "per s": "60per min",
                    "per min": "60per hr",
                    "per hr": "24per day",
                    "per day": "7per week"
                },
                "range": "n >= 0"
            }
        },
        {
            "name": ["percent", "percentage", "%"],
            "description": "Must be a percentage value between 0% and 100%, with the unit",
            "valid": {
                "units": ["%", "_x100%"],
                "target_unit": "_x100%",
                "aliases": {
                    "%": "percent"
                },
                "conversion": {
                    "100%": "1_x100%"
                },
                "range": "0 <= n <= 1"
            }
        }
    ]
}