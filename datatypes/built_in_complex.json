{
    "data_types": [
        {
            "name": ["alphanumeric string", "alphanumeric str", "alphanumeric"],
            "parent": "string",
            "valid": {
                "regex": "^[A-Z0-9a-z ]*$"
            }
        },
        {
            "name": ["strict alphanumeric", "strict alphanumeric string", "strict alphanumeric str"],
            "parent": "string",
            "valid": {
                "regex": "^[A-Z0-9a-z]+$"
            }
        },
        {
            "name": "duration",
            "description": "Must be a positive numerical duration with a time unit",
            "valid": {
                "units": ["s", "ms", "hr", "day", "min", "week"],
                "target_unit": "s",
                "aliases": {
                    "s": ["sec", "secs", "seconds", "second"],
                    "ms": ["msec", "msecs", "milliseconds", "millisecond"],
                    "min": ["m", "minute", "minutes", "mins"],
                    "day": ["days", "d"],
                    "hr": ["hour", "h", "hrs", "hours"],
                    "week": ["weeks", "wk", "w"]
                },
                "conversion": {
                    "s": "1000ms",
                    "min": "60s",
                    "hr": "60min",
                    "day": "24hr",
                    "week": "7day"
                },
                "range": "n >= 0"
            }
        },
        {
            "name": ["percent", "percentage", "%"],
            "description": "Must be a percentage value between 0% and 100%, with the unit",
            "valid": {
                "units": ["%", "_x100%"],
                "target_unit": "_x100%",
                "aliases": {
                    "%": "percent"
                },
                "conversion": {
                    "100%": "1_x100%"
                },
                "range": "0 <= n <= 1"
            }
        }
    ]
}